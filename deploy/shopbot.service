# Установка: sudo cp deploy/shopbot.service /etc/systemd/system/
#            sudo systemctl daemon-reload && sudo systemctl enable --now shopbot
[Unit]
Description=Telegram Shop Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=shopbot
Group=shopbot
WorkingDirectory=/opt/shopbot
EnvironmentFile=/opt/shopbot/.env
ExecStart=/opt/shopbot/venv/bin/python /opt/shopbot/bot.py
Restart=always
RestartSec=5
KillSignal=SIGINT
TimeoutStopSec=20

# логи: journalctl -u shopbot -f
StandardOutput=journal
StandardError=journal

# минимальные привилегии
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/shopbot

[Install]
WantedBy=multi-user.target
