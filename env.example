# ─── Обязательное ──────────────────────────────────────────────────────────
# Токен бота от @BotFather
BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Ваш Telegram ID (узнать: @userinfobot). Несколько — через запятую
ADMIN_IDS=123456789

# ─── Магазин ───────────────────────────────────────────────────────────────
# digital  — цифровой товар: без адреса доставки, выдача сразу после оплаты
# physical — физический: анкета с телефоном и адресом, оплата при получении
SHOP_MODE=digital

SHOP_NAME=Мой магазин
CURRENCY=₽
SUPPORT_CONTACT=@your_username

# Файл базы данных (в Docker — /data/shop.db)
DB_PATH=shop.db
LOG_LEVEL=INFO

# ─── Оплата ────────────────────────────────────────────────────────────────
# XTR — Telegram Stars: подключать ничего не нужно, подходит цифровым товарам.
#       STARS_RATE — сколько рублей вашего прайса приходится на одну ⭐.
#       Товар за 890 ₽ при STARS_RATE=2.0 превращается в счёт на 445 ⭐.
# RUB (или другая валюта) — карты через провайдера (@BotFather → Payments),
#       нужен PAYMENT_PROVIDER_TOKEN; для физических товаров это единственный путь.
PAYMENT_CURRENCY_CODE=XTR
PAYMENT_PROVIDER_TOKEN=
STARS_RATE=2.0

# ─── Подключение к серверу ─────────────────────────────────────────────────
# polling — бот сам опрашивает Telegram. Работает везде, домен не нужен.
# webhook — Telegram шлёт апдейты на ваш сервер. Нужен домен с HTTPS.
BOT_MODE=polling

# Только для BOT_MODE=webhook:
WEBHOOK_URL=https://shop.example.com
WEBHOOK_PATH=/webhook
# Произвольная строка, Telegram вернёт её в заголовке — защита от чужих запросов.
# Сгенерировать: openssl rand -hex 32
WEBHOOK_SECRET=
HOST=0.0.0.0
PORT=8080

# Если сервер ходит в интернет только через прокси (нужен пакет aiohttp-socks):
# TELEGRAM_PROXY=http://user:pass@proxy-host:3128
