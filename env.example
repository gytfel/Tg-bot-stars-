# ─── Обязательное ──────────────────────────────────────────────────────────
# Токен бота от @BotFather
BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Ваш Telegram ID (узнать: @userinfobot). Несколько — через запятую
ADMIN_IDS=123456789

# ─── Магазин ───────────────────────────────────────────────────────────────
SHOP_NAME=Мой магазин
CURRENCY=₽
SUPPORT_CONTACT=@your_username

# Файл базы данных (в Docker — /data/shop.db)
DB_PATH=shop.db
LOG_LEVEL=INFO

# ─── Оплата ────────────────────────────────────────────────────────────────
# Вариант A — Telegram Stars: ничего подключать не нужно.
#   PAYMENT_CURRENCY_CODE=XTR, PAYMENT_PROVIDER_TOKEN оставить пустым,
#   STARS_RATE — сколько рублей стоит одна ⭐ в вашем прайсе.
# Вариант B — карты через провайдера (@BotFather → Payments → ЮKassa и др.):
#   PAYMENT_CURRENCY_CODE=RUB и токен провайдера в PAYMENT_PROVIDER_TOKEN.
# Если оба пусты — в меню остаются оплата при получении и перевод.
PAYMENT_PROVIDER_TOKEN=
PAYMENT_CURRENCY_CODE=RUB
STARS_RATE=2.0

# ─── Подключение к серверу ─────────────────────────────────────────────────
# polling — бот сам опрашивает Telegram. Работает везде, домен не нужен.
# webhook — Telegram шлёт апдейты на ваш сервер. Нужен домен с HTTPS.
BOT_MODE=polling

# Только для BOT_MODE=webhook:
WEBHOOK_URL=https://shop.example.com
WEBHOOK_PATH=/webhook
# Произвольная строка, Telegram вернёт её в заголовке — защита от чужих запросов.
# Сгенерировать: openssl rand -hex 32
WEBHOOK_SECRET=
HOST=0.0.0.0
PORT=8080

# Если сервер ходит в интернет только через прокси (нужен пакет aiohttp-socks):
# TELEGRAM_PROXY=http://user:pass@proxy-host:3128
