# ─── Обязательное ──────────────────────────────────────────────────────────
# Токен бота от @BotFather
BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Ваш Telegram ID (узнать: @userinfobot). Несколько — через запятую
ADMIN_IDS=123456789

# ─── Что продаём ───────────────────────────────────────────────────────────
# stars    — Telegram Stars: покупатель выбирает количество, платит и получает
#            звёзды на свой @username
# digital  — цифровой товар: доступы, файлы, консультации
# physical — физический: анкета с телефоном и адресом, оплата при получении
SHOP_MODE=stars

SHOP_NAME=Мой магазин
CURRENCY=₽
SUPPORT_CONTACT=@your_username

# Файл базы данных (в Docker — /data/shop.db)
DB_PATH=shop.db
LOG_LEVEL=INFO

# ─── Цена звёзд ────────────────────────────────────────────────────────────
# Сколько рублей стоит одна ⭐ у вас в продаже
STAR_PRICE=1.6
# Минимум для заказа. Меньше 50 нельзя — столько же минимум у самого Fragment
MIN_STARS=50
MAX_STARS=100000
# Готовые наборы в меню
STAR_PACKAGES=50,100,250,500,1000

# ─── Оплата в TON ──────────────────────────────────────────────────────────
# Кошелёк, на который покупатели переводят TON. Нужен только адрес —
# сид-фраза и ключи боту не нужны, он читает только входящие переводы.
TON_WALLET=

# API для чтения транзакций (по умолчанию toncenter, ключ повышает лимиты)
TON_API_URL=https://toncenter.com/api/v3
TON_API_KEY=

# Курс: фиксированный (надёжнее) или из API, если оставить 0
TON_RATE_RUB=0
TON_RATE_URL=https://tonapi.io/v2/rates?tokens=ton&currencies=rub

# Как часто проверять входящие переводы и сколько ждать оплату, секунды
TON_CHECK_INTERVAL=60
TON_INVOICE_TTL=3600
# Допуск на недоплату из-за комиссии и округления (0.02 = 2%)
TON_TOLERANCE=0.02

# ─── Закупка звёзд через Fragment ──────────────────────────────────────────
# manual — бот присылает админу задачу «купить 500 ⭐ для @user», покупка
#          делается руками на fragment.com, выдача подтверждается кнопкой
# api    — автозакупка через сторонний шлюз (у самого Fragment публичного API нет)
FRAGMENT_MODE=manual
FRAGMENT_API_URL=
FRAGMENT_API_TOKEN=
# Пути у шлюзов различаются — при необходимости поправьте
FRAGMENT_BUY_PATH=/buyStars
FRAGMENT_BALANCE_PATH=/balance
FRAGMENT_TIMEOUT=60
FRAGMENT_RETRIES=3
# Предупреждать, когда баланс шлюза ниже этого значения (0 — не предупреждать)
FRAGMENT_MIN_BALANCE=0

# ─── Оплата картой (для SHOP_MODE=digital или physical) ────────────────────
# XTR — Telegram Stars как способ оплаты цифрового товара, провайдер не нужен.
# RUB и другие валюты — карты через провайдера (@BotFather → Payments).
PAYMENT_CURRENCY_CODE=RUB
PAYMENT_PROVIDER_TOKEN=
STARS_RATE=2.0

# ─── Подключение к серверу ─────────────────────────────────────────────────
# polling — бот сам опрашивает Telegram. Работает везде, домен не нужен.
# webhook — Telegram шлёт апдейты на ваш сервер. Нужен домен с HTTPS.
BOT_MODE=polling

# Только для BOT_MODE=webhook:
WEBHOOK_URL=https://shop.example.com
WEBHOOK_PATH=/webhook
# Произвольная строка, Telegram вернёт её в заголовке — защита от чужих запросов.
# Сгенерировать: openssl rand -hex 32
WEBHOOK_SECRET=
HOST=0.0.0.0
PORT=8080

# Если сервер ходит в интернет только через прокси (нужен пакет aiohttp-socks):
# TELEGRAM_PROXY=http://user:pass@proxy-host:3128
