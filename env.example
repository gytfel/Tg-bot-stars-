# Токен бота от @BotFather
BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Ваш Telegram ID (узнать: @userinfobot). Несколько — через запятую
ADMIN_IDS=123456789

# Название магазина и валюта
SHOP_NAME=Мой магазин
CURRENCY=₽

# Файл базы данных
DB_PATH=shop.db

# Токен платёжного провайдера (@BotFather -> Payments).
# Если пустой — онлайн-оплата в меню не показывается
PAYMENT_PROVIDER_TOKEN=
PAYMENT_CURRENCY_CODE=RUB

# Контакты для раздела "О магазине"
SUPPORT_CONTACT=@your_username
